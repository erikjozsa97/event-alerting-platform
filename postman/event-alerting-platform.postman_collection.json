                "{{alert_rule_id}}",
                "test-notification"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Test alert\",\n  \"body\": \"This is a manually triggered test notification from Postman.\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Returns one delivery per linked channel', () => pm.expect(data).to.be.an('array').that.is.not.empty);",
                  "pm.test('Each delivery has a status of SENT or FAILED', () => {",
                  "    data.forEach(d => pm.expect(['SENT', 'FAILED']).to.include(d.status));",
                  "});",
                  "// EMAIL deliveries should be SENT if MailHog is running (docker compose up).",
                  "// SLACK deliveries will be FAILED against the placeholder webhook URL from",
                  "// the Channels folder \u2014 that's expected unless you swapped in a real one.",
                  "// Check http://localhost:8025 to see any emails MailHog received."
                ]
              }
            }
          ]
        },
